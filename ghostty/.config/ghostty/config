# https://ghostty.org/docs/config documentation

# fonts config
font-size = 16
font-family = JetBrainsMono NFM
# font-family = IBM Plex Mono

# cursor config
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# do not ask for confirmation when trying close surface
confirm-close-surface = false

# windows

window-decoration = false

# theme

theme = Rose Pine

# keybinds

# remove the default keybinds
keybind=clear
keybind = global:super+o=toggle_quick_terminal
keybind = ctrl+shift+k=increase_font_size:1.5
keybind = ctrl+shift+j=decrease_font_size:1.5
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+0=reset_font_size

background-opacity = 0.90

# Add paddings
window-padding-x = 10
window-padding-y = 10
