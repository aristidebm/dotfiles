#!/usr/bin/env sh

function ignore() {
    source "$HOME/.local/bin/fgi"

    # Check if the current directory is a git
    # repository
    git rev-parse --is-inside-work-tree 2> /dev/null

    local exit_code=$?
    if [ $exit_code -ne 0 ]; then
        # The current directory is not a git
        # repository, ask the user if he wants to create none

        read -p "This directory is not a Git repository. Would you like to initialize one? (yes/no) " res

        # translate user input to upper case
        res=$(echo $res | tr "[:lower:]" "[:upper:]")

        case $res in
          Y*)
              git init .
              # command -v jj >/dev/null 2>&1 && jj git init --colocate
              ;;
          *) exit $exit_code ;;
        esac
    fi

    # Attempt the fetching of the git ignore file
    fgi $@ > .gitignore
}

ignore $@
