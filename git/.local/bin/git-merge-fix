#!/usr/bin/env sh

function merge_fix() {
    source "$HOME/.local/bin/git-resolve"
    # Merge as usual
    git merge "$@"
    # Retreive the process exit_code
    exit_code=$?

    if [ $exit_code -ne 0 ]; then
      # The merging process has failed,
      # resolve conflicts if any.
      resolve
      # exit $status
    fi
}

merge_fix $@
