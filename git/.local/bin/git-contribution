#!/usr/bin/env sh

function contributions() {

    if ! is_git_repo; then
        echo "You are not inside a git repo"
        exit 1
    fi

    # take the first argument only
    local selected=$1

    if [[ -z $selected ]]; then
        # open a fuzzy finder of contributions
        selected=$(git contributor | fzf --prompt="Author > ")
    fi

    if [[ -z $selected ]]; then
        # The user as selected nothing, so there is nothing to do
        exit 0
    fi

    selected=$(echo $selected | awk '{print $1}')
    # List all the contribustions of the selected author
    git log --author=$selected --date=short --pretty=format:"%ad %h %s" --author-date-order
}

function is_git_repo() {
    if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

contributions $@
