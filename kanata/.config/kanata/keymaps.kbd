;; Colemak angle mode
;;(deflayer colemak-dh-angle
;; esc f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   @qwe
;; grv  1    2    3    4    5    6    7    8    9    0    -     =        bspc
;; tab  q    w    f    p    b    j    l    u    y    ;    [     ]        ret
;; caps @a    r    s    t    g    m    n    e    i    o    '     \
;; lsft z    x    c    d    v    /    k    h    ,    .    /              rsft
;; wkup lalt lmet lctrl          spc            rctrl prnt ralt     pgup up  pgdn
;;                                                                  left down rght
;; )

;; Navigation layer
(deflayer vimnav
  XX    XX     XX     XX     XX     XX     XX     XX      XX       XX         XX     XX     XX
  XX    XX     XX     XX     XX     XX     XX     XX      XX       XX         XX     XX     XX     XX
  XX    XX     XX     XX     XX     XX     XX     XX      XX       XX         XX     XX     XX     XX
  XX    XX     XX     XX     XX     XX     lft   down     up       rght      XX     XX     XX
  XX    XX     XX     XX     XX     XX     XX     XX      XX       XX         XX     XX            XX
  XX    XX     XX     XX                   XX             XX       XX         XX             XX    XX   XX
                                                                                             XX    XX   XX
)

;; Num layer
(deflayer num
  XX     XX     XX     XX     XX     XX     XX     XX      XX       XX         XX     XX     XX
  XX     XX     XX     XX     XX     XX     XX     XX      XX       XX         XX     XX     XX     XX
  XX     XX     XX     XX     XX     XX     =      7       8        9          +      XX     XX     XX
  XX     XX     XX     XX     XX     XX     XX     4       5        6          -      XX     XX
  XX     XX     XX     XX     XX     XX     XX     0       1        2          3      /             XX
  XX     XX     XX     XX                   XX             XX       XX         XX              XX   XX   XX
                                                                                               XX   XX   XX
)
