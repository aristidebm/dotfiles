;;  caps @a    s    d    f    g    h    j    k    l    ;    '     \
;;  lsft z    x    c    b    v    /     n    m    ,    .    /           rsft
;;  wkup lalt lmet lctrl          spc            rctrl  ralt  prnt     pgup up  pgdn
;;                                                                   lft down rght
